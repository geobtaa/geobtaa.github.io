{
  "name": "btaa-gin-website",
  "type": "module",
  "version": "0.0.1",
  "scripts": {
    "postinstall": "patch-package --error-on-fail",
    "dev": "astro dev",
    "start": "astro dev",
    "decap": "BIND_HOST=127.0.0.1 decap-server",
    "editor": "node --env-file-if-exists=.env.local editor/server.mjs",
    "test:editor": "node --test editor/*.test.mjs",
    "test:editor:browser": "node --test --test-concurrency=1 editor/*.browser.mjs",
    "test:editor:render": "node --test tests/cms-links-render.test.mjs && node --test tests/unpublish-build.test.mjs",
    "test:editor:publication": "node --test tests/unpublish-build.test.mjs",
    "test:news": "node --test tests/news-archive.test.mjs tests/news-archive.browser.mjs",
    "test:navigation": "node --test tests/site-navigation.test.mjs",
    "test:config": "node --test tests/fullview-mode.test.mjs",
    "build": "astro build",
    "build:editor": "astro build --config astro.editor.config.ts",
    "test:editor:build": "npm run build:editor && node --test tests/editor-build.test.mjs",
    "preview": "astro preview",
    "astro": "astro",
    "optimize-gallery": "node scripts/optimize-gallery.mjs"
  },
  "dependencies": {
    "@astrojs/check": "^0.9.5",
    "@astrojs/markdown-remark": "^7.3.4",
    "@astrojs/starlight": "^0.42.7",
    "@iconify-json/mdi": "^1.2.3",
    "@mdx-js/mdx": "^3.1.1",
    "@tiptap/extension-code-block": "^3.31.3",
    "@tiptap/extension-image": "^3.31.3",
    "@tiptap/extension-link": "^3.31.3",
    "@tiptap/extension-table": "^3.31.3",
    "@tiptap/markdown": "^3.31.3",
    "@tiptap/react": "^3.31.3",
    "@tiptap/starter-kit": "^3.31.3",
    "astro": "~7.4.2",
    "astro-icon": "^1.2.0",
    "character-entities": "^2.0.2",
    "d3-dsv": "^3.0.1",
    "github-slugger": "2.0.0",
    "leaflet": "^1.9.4",
    "leaflet.markercluster": "^1.5.3",
    "mdast-util-directive": "^3.1.1",
    "mdast-util-from-markdown": "^2.1.0",
    "mdast-util-gfm": "^3.1.0",
    "mdast-util-mdx": "^3.0.0",
    "micromark-extension-directive": "^4.0.0",
    "micromark-extension-gfm": "^3.0.0",
    "micromark-extension-mdxjs": "^3.0.0",
    "micromark-util-decode-numeric-character-reference": "^2.0.2",
    "papaparse": "^5.5.3",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "remark-directive": "^4.0.0",
    "remark-gfm": "^4.0.1",
    "reveal.js": "^5.2.1",
    "sharp": "^0.34.2",
    "starlight-fullview-mode": "0.2.6",
    "starlight-image-zoom": "^0.16.2",
    "starlight-links-validator": "^0.27.0",
    "starlight-showcases": "^0.3.2",
    "starlight-videos": "^0.5.0",
    "starlight-view-modes": "^0.11.0",
    "typescript": "^5.9.3",
    "yaml": "^2.9.1"
  },
  "devDependencies": {
    "@astrojs/react": "^7.1.1",
    "@squoosh/cli": "^0.7.1",
    "@types/papaparse": "^5.3.16",
    "@types/react": "^19.1.12",
    "@types/react-dom": "^19.1.9",
    "decap-server": "3.11.0",
    "esbuild": "0.28.2",
    "linkedom": "^0.14.26",
    "miniflare": "4.20260730.0",
    "patch-package": "8.0.1",
    "prettier": "^3.6.2"
  },
  "volta": {
    "node": "24.13.1"
  },
  "engines": {
    "node": ">=22.23.4"
  }
}
