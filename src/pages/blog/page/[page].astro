---
import BlogArchive from '../../../components/BlogArchive.astro';
import { loadBlogContent } from '../../../utils/blogContent';
import { BLOG_PAGE_SIZE } from '../../../utils/blogArchive';

export async function getStaticPaths() {
  const { items } = await loadBlogContent();
  return Array.from({ length: Math.max(0, Math.ceil(items.length / BLOG_PAGE_SIZE) - 1) }, (_, index) => ({
    params: { page: String(index + 2) }, props: { page: index + 2 },
  }));
}
const { page } = Astro.props;
---
<BlogArchive page={page} />
