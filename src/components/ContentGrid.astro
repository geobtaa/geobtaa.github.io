---
type Item = {
  url: string;
  category: 'post' | 'update';
  title: string;
  excerpt?: string;
  tags: string[];
  authors: string[];
  published?: Date;
  year?: number;
  cover?: {
    image: string;
    alt?: string;
  };
};

interface Props {
  items: Item[];
  start?: number;
  end?: number;
}

const { items, start = 0, end = items.length } = Astro.props as Props;

const formatter = new Intl.DateTimeFormat('en-US', {
  month: 'long',
  day: 'numeric',
  year: 'numeric',
});

const hasItems = items.length > 0;
---

<div class="grid" data-blog-grid>
  {items.map((item, index) => (
    <a
      class="grid-card"
      href={item.url}
      hidden={index < start || index >= end}
      data-blog-card
      data-tags={JSON.stringify(item.tags)}
      data-authors={JSON.stringify(item.authors)}
      data-year={item.year ? String(item.year) : ''}
      data-date={item.published ? String(item.published.getTime()) : ''}
      data-category={item.category}
      data-index={String(index)}
      data-search={`${item.title} ${item.excerpt ?? ''}`}
    >
      <header class="grid-card__header">
        {item.cover && (
          <div class="grid-card__cover">
            <img src={item.cover.image} alt={item.cover.alt || ''} loading="lazy" decoding="async" />
          </div>
        )}
        <h3 class="grid-card__title">{item.title}</h3>
        <div class="grid-card__metadata">
        {item.published && (
          <time class="grid-card__meta" datetime={item.published.toISOString()}>
            {formatter.format(item.published)}
          </time>
        )}
        {item.category === 'update' && <span class="grid-card__badge grid-card__badge--update">Program Update</span>}
        </div>
      </header>

      {item.excerpt && <p class="grid-card__excerpt">{item.excerpt}</p>}

    </a>
  ))}
</div>

<div class="grid__empty" data-blog-empty hidden={hasItems ? true : undefined}>
  <p>No results match the selected filters. Try clearing one or more filters to broaden your search.</p>
</div>

<style>
  .grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(min(100%, 280px), 1fr));
    gap: 1.5rem;
  }

  .grid__empty {
    padding: 2rem;
    text-align: center;
    border: 1px dashed var(--sl-color-hairline);
    border-radius: 0.75rem;
  }

  .grid-card {
    display: flex;
    flex-direction: column;
    gap: 1rem;
    padding: 1.25rem;
    border: 1px solid var(--sl-color-hairline);
    border-radius: 1rem;
    background: var(--sl-color-bg);
    box-shadow: 0 2px 8px rgba(15, 23, 42, 0.05);
    text-decoration: none;
    color: inherit;
    transition: transform 150ms ease, box-shadow 150ms ease, border-color 150ms ease;
    min-height: 100%;
  }

  .grid-card[hidden] { display: none; }

  .grid-card:hover,
  .grid-card:focus-visible {
    transform: translateY(-4px);
    box-shadow: 0 8px 20px rgba(15, 23, 42, 0.12);
    border-color: transparent;
  }

  .grid-card__header {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
  }

  .grid-card__metadata { display: flex; flex-wrap: wrap; align-items: center; gap: .5rem .75rem; }

  .grid-card__badge {
    display: inline-flex;
    align-self: flex-start;
    padding: 0.2rem 0.6rem;
    border-radius: 999px;
    font-family: var(--font-family-nav);
    font-size: 0.75rem;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.04em;
    color: #fff;
    background: var(--btaa-med-blue);
  }

  .grid-card__badge--update {
    color: var(--btaa-med-blue);
    background: #dff1fa;
  }

  .grid-card__cover {
    width: 100%;
    aspect-ratio: 16 / 9;
    overflow: hidden;
    border-radius: 0.75rem;
  }

  .grid-card__cover img {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .grid-card__title {
    margin: 0;
    font-size: 1.25rem;
    line-height: 1.3;
  }

  .grid-card__meta {
    color: var(--sl-color-text);
    font-size: 0.9rem;
  }

  .grid-card__excerpt {
    margin: 0;
    color: var(--sl-color-text);
    line-height: 1.55;
    flex-grow: 1;
    display: -webkit-box;
    -webkit-line-clamp: 3;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

</style>
